programa {
  funcao inicio() {
    
    cadeia n
    inteiro idd
    real p
    real h

    escreva ("Escreva seu nome: ")
    leia (n)
    escreva ("Escreva a sua idade: ")
    leia (idd)
    escreva ("Escreva seu peso: ")
    leia (p)
    escreva ("Escreva a sua altura: ")
    leia (h)

    escreva ("Nome: ", n, "\n", "Idade: ", idd, "\n", "Peso: ", p, "\n", "Altura: ", h )
  }
}